FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (@UX@ @UY@ 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (@UX@ @UY@ 0);
    }
    outlet
    {
        type            zeroGradient;
    }
    blade
    {
        type            noSlip;
    }
    periodic_bottom
    {
        type            cyclic;
    }
    periodic_top
    {
        type            cyclic;
    }
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
}

