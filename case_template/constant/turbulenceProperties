FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location "constant";
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType  RAS;

RAS
{
    model           kOmegaSST;
    RASModel        kOmegaSST;      // legacy keyword, kept so older/newer parsers both find it

    turbulence      on;
    printCoeffs     on;
}

