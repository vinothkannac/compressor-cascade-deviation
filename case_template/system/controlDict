FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         @MAX_ITER@;
deltaT          1;

writeControl    timeStep;
writeInterval   @WRITE_INTERVAL@;
purgeWrite      2;

// Python post-processing reads ASCII files: do not change.
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;

runTimeModifiable false;

