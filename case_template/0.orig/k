FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform @K@;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform @K@;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform @K@;
        value           uniform @K@;
    }
    blade
    {
        type            kqRWallFunction;
        value           uniform @K@;
    }
    periodic_bottom
    {
        type            cyclic;
    }
    periodic_top
    {
        type            cyclic;
    }
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
}

