FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-10;
        relTol          0.05;
    }

    "(U|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-10;
        relTol          0.1;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 1;
    consistent      yes;

    residualControl
    {
        p               @RES_P@;
        U               @RES_U@;
        k               @RES_K@;
        omega           @RES_OMEGA@;
    }
}

relaxationFactors
{
    equations
    {
        U               @RELAX_U@;
        "(k|omega)"     @RELAX_TURB@;
    }
}

